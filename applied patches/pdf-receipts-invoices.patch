+function fmtDate(d) {
+  if (!d) return "--";
+  const date = new Date(d);
+  if (isNaN(date.getTime())) return "--";
+  return date.toLocaleDateString();
+}
+
+function fmtMoney(n) {
+  if (n === null || n === undefined || n === "") return "--";
+  const v = parseFloat(n);
+  return isNaN(v) ? "--" : `$${v.toFixed(2)}`;
+}
+
